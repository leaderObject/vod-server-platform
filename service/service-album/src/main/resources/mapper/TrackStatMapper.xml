<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >


<mapper namespace="com.atfangyi.tingshu.album.mapper.TrackStatMapper">

    <insert id="saveTrackStatInfo">
        insert into track_stat(track_id,stat_type) values
        <foreach collection="list" item="statType" separator=",">
            (#{id},#{statType})
        </foreach>
    </insert>

</mapper>

