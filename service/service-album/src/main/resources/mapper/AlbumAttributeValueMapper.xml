<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >


<mapper namespace="com.atfangyi.tingshu.album.mapper.AlbumAttributeValueMapper">
    <insert id="saveAlbumAttributeValue">
        insert into album_attribute_value (attribute_id,value_id,album_id)
        values
        <foreach collection="albumAttributeValueVoList" item="albumAttributeValueVo" separator=",">
            (#{albumAttributeValueVo.attributeId},#{albumAttributeValueVo.valueId},#{id})
        </foreach>
    </insert>

</mapper>

